# =============================================================================
# EPCRC .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# IDE / Editors
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Results & Data (generated, don't commit)
# -----------------------------------------------------------------------------
data/raw/
data/processed/

# Per-experiment caches (bundle.npz, fitted models, etc.)
data/*.csv
data/smoke_cache/

# Judged pairs: megabytes of response text per seed, regenerated by
# experiments/build_rewardbench_pairs.py and build_judgebench_pairs.py.  The
# split manifests next to them are small and carry the checksums, so those stay
# in git.
data/pairs_seed*.jsonl
data/judgebench_pairs_seed*.jsonl

# Every experiment writes here: judge score caches, per-claim JSON, figures and
# the delivery zip.  That is ~150 MB of machine output, all of it reproducible
# from the scripts, so it is regenerated rather than versioned.  The committed
# notebooks keep their executed outputs, so the numbers stay readable on GitHub.
results/

# Keep directory structure
!results/.gitkeep
!data/.gitkeep

# -----------------------------------------------------------------------------
# Model checkpoints (too large for git)
# -----------------------------------------------------------------------------
checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
wandb/
mlruns/

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.pdf
*.bak
*.tmp
*.temp
.env
.env.local
secrets.yaml

# Local snapshots of earlier result trees, kept as a safety net for reruns and
# not part of the project history.
.backup_results_*/

# Leftovers from the earlier UTD19 study and from the retired docs/geometry
# figure builder.  Neither feeds anything in this repository.
data/exp_0_utd19_cache/
docs/geometry/

# The LaTeX manuscript and its build products live in a separate repository.
paper/
paper.zip

# graphify: the knowledge graph is rebuilt from source by `graphify update .`
graphify-out/

# Claude Code local settings
.claude/
CLAUDE.md
