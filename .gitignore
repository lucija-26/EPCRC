# =============================================================================
# EPCRC .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# IDE / Editors
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Results & Data (generated, don't commit)
# -----------------------------------------------------------------------------
data/raw/
data/processed/

# UTD19 dataset + per-experiment caches (trained models, bundle.npz, etc.)
data/utd19_u.csv
data/*.csv
data/exp_0_utd19_cache/
data/smoke_cache/
data/exp00_models/
data/exp000_models/

# Keep directory structure
!results/.gitkeep
!data/.gitkeep

# -----------------------------------------------------------------------------
# Model checkpoints (too large for git)
# -----------------------------------------------------------------------------
checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
wandb/
mlruns/

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.pdf
*.bak
*.tmp
*.temp
.env
.env.local
secrets.yaml

# Pre-cleanup snapshot of the old results tree (2026-08-16), kept locally as a
# safety net for the rerun; not part of the project history.
.backup_results_*/

# -----------------------------------------------------------------------------
# graphify: keep the current graph, ignore what regenerates from it
# -----------------------------------------------------------------------------
# The AST cache and the per-run dated snapshots (which just duplicate the
# top-level graph.json / manifest.json / GRAPH_REPORT.md) are rebuilt by
# `graphify update .`, so only the current graph is tracked.
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# Local state: a "." root marker and node labels rebuilt from graph.json.
graphify-out/.graphify_root
graphify-out/.graphify_labels.json

# Claude Code local settings
.claude/
